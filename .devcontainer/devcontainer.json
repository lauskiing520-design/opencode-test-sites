{
  "name": "临时测试站",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "apt-get update && apt-get install -y php-cli",
  "postStartCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "测试站",
      "requireLocalhost": false,
      "onAutoForward": "openBrowser"
    }
  }
}
